# Template for local Worker secrets — copy to `.dev.vars` (gitignored) and fill in real values
# for `wrangler dev`. In production these are set via `wrangler secret put` (encrypted), NOT here.

# Resend API key — account: revenueautomationlab@gmail.com · verified domain: mail.raltech.dev
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# RAL Finance API: base URL + service JWT (HS256 with the API JWT_SECRET, email = owner, svc = true)
FINANCE_API_URL=https://finance-api.raltech.dev
FINANCE_API_TOKEN=eyJhbGci...service_jwt...

# Guards the manual /preview + /send fetch endpoint
TRIGGER_TOKEN=choose-a-random-string
